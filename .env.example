# Provider selection is required. Use "fake" for deterministic local runs.
AGENTLAB_MODEL_PROVIDER=fake

# For real OpenAI function calling, set the provider to "openai" and configure:
# AGENTLAB_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# For real Gemini function calling, set the provider to "gemini" and configure:
# AGENTLAB_MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=

# For an already running local Chat Completions endpoint (no automatic model download):
# AGENTLAB_MODEL_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_API_KEY=
